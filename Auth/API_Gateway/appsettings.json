{
  "_security_comment": "=== SECRET STORAGE (must match the Auth API) ===",
  "SecretManagement": {
    "_comment": "StorageMode MUST match the Auth API, and defaults to the same value it does: Certificate. Certificate/Dpapi: the token is read from the shared encrypted secrets file (set SecretFilePath to the SAME file the Auth API uses, and DataProtection:Certificate to the SAME certificate). PlainText: set Gateway:Token below to the Auth API's generated token. In Development ONLY, a missing certificate falls back to PlainText — the Auth API applies the identical fallback, so the pair stays in agreement; every other environment fails to start instead.",
    "StorageMode": "Certificate",
    "SecretFilePath": ""
  },
  "DataProtection": {
    "_comment": "Must point to the SAME key ring the Auth API uses. Empty = default %ProgramData%\\AuthSystem\\Keys. On IIS / shared hosting the app-pool identity often cannot write under %ProgramData%, so set this to the SAME writable folder (outside the public web root) configured for the Auth API.",
    "KeyPath": "",
    "Certificate": {
      "_comment": "Only used when StorageMode = Certificate. Must be the SAME certificate the Auth API uses.",
      "PfxPath": "",
      "Password": "",
      "PasswordEnvironmentVariable": "AUTH_DP_CERT_PASSWORD",
      "Thumbprint": "",
      "AdditionalPfxPaths": []
    }
  },

  "_gateway_comment": "=== API GATEWAY TOKEN ===",
  "Gateway": {
    "_comment": "PlainText mode (including the Development fallback): paste the Auth API's generated gateway token here — it is written to the API's appsettings.{Environment}.json as Gateway:ExpectedToken. Certificate/Dpapi mode: leave empty (loaded from the shared encrypted secrets file).",
    "Token": ""
  },

  "_proxy_comment": "=== REVERSE PROXY CONFIGURATION (YARP) === Routes are a per-feature allowlist: only listed prefixes are forwarded (deny-by-default). v{version:int} matches every numeric API version (v1, v2, ...), so new versions need no gateway change; new features DO need a new route (GatewayRouteCoverageTests enforces this). Comment keys are not allowed inside Routes/Clusters (YARP binds every child as config).",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "auth",
        "Match": {
          "Path": "/api/v{version:int}/auth/{**catch-all}"
        }
      },
      "users-route": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "api",
        "Match": {
          "Path": "/api/v{version:int}/users/{**catch-all}"
        }
      },
      "roles-route": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "api",
        "Match": {
          "Path": "/api/v{version:int}/roles/{**catch-all}"
        }
      },
      "permissions-route": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "api",
        "Match": {
          "Path": "/api/v{version:int}/permissions/{**catch-all}"
        }
      },
      "apikeys-route": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "api",
        "Match": {
          "Path": "/api/v{version:int}/apikeys/{**catch-all}"
        }
      },
      "applications-route": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "api",
        "Match": {
          "Path": "/api/v{version:int}/applications/{**catch-all}"
        }
      },
      "organizations-route": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "api",
        "Match": {
          "Path": "/api/v{version:int}/organizations/{**catch-all}"
        }
      },
      "invitations-route": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "api",
        "Match": {
          "Path": "/api/v{version:int}/invitations/{**catch-all}"
        }
      },
      "auditlogs-route": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "api",
        "Match": {
          "Path": "/api/v{version:int}/audit-logs/{**catch-all}"
        }
      },
      "dashboard-route": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "api",
        "Match": {
          "Path": "/api/v{version:int}/dashboard/{**catch-all}"
        }
      },
      "images-route": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "api",
        "Match": {
          "Path": "/api/v{version:int}/images/{**catch-all}"
        }
      },
      "webhookkeys-route": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "api",
        "Match": {
          "Path": "/api/v{version:int}/webhookkeys/{**catch-all}"
        }
      },
      "platform-route": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "api",
        "Match": {
          "Path": "/api/v{version:int}/platform/{**catch-all}"
        }
      },
      "notification-templates-route": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "api",
        "Match": {
          "Path": "/api/v{version:int}/notification-templates/{**catch-all}"
        }
      },
      "notification-types-route": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "api",
        "Match": {
          "Path": "/api/v{version:int}/notification-types/{**catch-all}"
        }
      },
      "notification-layouts-route": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "api",
        "Match": {
          "Path": "/api/v{version:int}/notification-layouts/{**catch-all}"
        }
      },
      "notification-outbox-route": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "api",
        "Match": {
          "Path": "/api/v{version:int}/notification-outbox/{**catch-all}"
        }
      },
      "admin-route": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "admin",
        "Match": {
          "Path": "/api/v{version:int}/admin/{**catch-all}"
        }
      },
      "discovery-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/.well-known/{**catch-all}"
        }
      },
      "openapi-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/openapi/{**catch-all}"
        }
      },
      "uploads-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/uploads/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-api": {
            "Address": "{{AUTH_API_INTERNAL_URL}}"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "HttpClient": {
          "RequestHeaderEncoding": "utf-8"
        }
      }
    }
  },

  "_ratelimit_comment": "=== RATE LIMITING ===",
  "RateLimiting": {
    "GlobalPermitLimit": 1000,
    "GlobalWindowSeconds": 60,
    "GlobalQueueLimit": 100,
    "AuthPermitLimit": 20,
    "AuthWindowSeconds": 60,
    "ApiPermitLimit": 100,
    "ApiWindowSeconds": 60,
    "AdminPermitLimit": 10,
    "AdminWindowSeconds": 60
  },

  "_services_comment": "=== BACKEND SERVICES ===",
  "Services": {
    "AuthApi": {
      "BaseUrl": "{{AUTH_API_INTERNAL_URL}}",
      "HealthUrl": "{{AUTH_API_INTERNAL_URL}}/health",
      "_readyurl_comment": "Readiness probe target. The gateway's /ready aggregates this. Leave empty to derive it from BaseUrl + /ready (recommended). Only set this if /ready lives on a different host/path than BaseUrl. A non-empty value that is not a valid absolute http(s) URL is ignored (BaseUrl is used instead).",
      "ReadyUrl": ""
    }
  },

  "_healthchecks_comment": "=== HEALTH CHECKS ===",
  "HealthChecks": {
    "_comment": "ExposeErrorDetails: include failed-check exception messages in the /health and /ready JSON. /health and /ready are PUBLIC, so keep this false in production; enable briefly only to diagnose. Full errors are always in the server logs.",
    "ExposeErrorDetails": false
  },

  "_cors_comment": "=== CORS CONFIGURATION (OWASP A02) ===",
  "Cors": {
    "_comment": "REQUIRED for production: Specify allowed origins explicitly",
    "AllowedOrigins": [
      "{{FRONTEND_ORIGIN_1}}",
      "{{FRONTEND_ORIGIN_2}}"
    ]
  },

  "_logging_comment": "=== STRUCTURED LOGGING (Serilog) ===",
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/gateway-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },

  "AllowedHosts": "*"
}
