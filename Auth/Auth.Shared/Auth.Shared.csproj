<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared startup/security infrastructure is consumed only by the two
         ASP.NET hosts. The framework reference supplies their HTTP,
         configuration, Data Protection and health-check contracts as one
         coherent runtime instead of duplicating packages already in it. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
