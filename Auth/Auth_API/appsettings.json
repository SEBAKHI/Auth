{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AuthDb": "Data Source=localhost\\SQLEXPRESS01;Initial Catalog=Astoom_Auth;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Issuer": "https://auth.local",
    "Audience": "https://api.local",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 7,
    "KeyId": "auth-key-1",
    "RotateRefreshTokens": true,
    "ClockSkewSeconds": 60,
    "PrivateKeyPath": "",
    "PrivateKeyPem": "",
    "PrivateKeyEncrypted": "",
    "RefreshTokenEncryptedKey": ""
  },
  "DataProtection": {
    "KeyPath": ""
  },
  "Password": {
    "MinimumLength": 12,
    "RequireUppercase": true,
    "RequireLowercase": true,
    "RequireDigit": true,
    "RequireSpecialCharacter": true,
    "HistoryCount": 5,
    "ExpirationDays": 90,
    "MaxFailedAttempts": 5,
    "LockoutDurationMinutes": 15,
    "Argon2MemorySize": 19456,
    "Argon2Iterations": 2,
    "Argon2Parallelism": 1,
    "SaltSize": 16,
    "HashSize": 32
  },
  "Gateway": {
    "TokenHeaderName": "X-Gateway-Token",
    "ExpectedToken": "",
    "ValidationEnabled": false,
    "ExemptPaths": [
      "/.well-known/",
      "/health",
      "/ready",
      "/swagger"
    ]
  },
  "Session": {
    "LifetimeHours": 24,
    "ExtendOnActivity": true,
    "ExtensionHours": 1,
    "MaxConcurrentSessions": 5,
    "TerminateOldestOnMax": true,
    "IdleTimeoutMinutes": 30
  },
  "Email": {
    "SmtpHost": "smtp.example.com",
    "SmtpPort": 587,
    "UseSsl": true,
    "Username": "",
    "Password": "",
    "SenderEmail": "noreply@example.com",
    "SenderName": "Auth System",
    "OtpExpirationMinutes": 15,
    "RateLimitWindowSeconds": 60,
    "MaxOtpRequestsPerWindow": 3,
    "Enabled": false
  },
  "RateLimiting": {
    "EnableRateLimiting": true,
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 10,
    "LoginPermitLimit": 5,
    "LoginWindowSeconds": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/auth-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  }
}
