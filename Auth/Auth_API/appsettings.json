{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "_dependencies_comment": "=== CONNECTION STRINGS ===",
  "ConnectionStrings": {
    "_comment": "Development: Uses Windows Auth. Production: Use appsettings.Production.json with SQL Auth + Encrypt=True",
    "AuthDb": "ConnectionStrings__AuthDb"
  },

  "_jwt_comment": "=== JWT AUTHENTICATION ===",
  "Jwt": {
    "_comment": "Keys are auto-generated on first startup via DPAPI. Override Issuer/Audience for production.",
    "Issuer": "{{JWT_ISSUER_URL}}",
    "Audience": "{{JWT_AUDIENCE_URL}}",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 7,
    "KeyId": "auth-key-1",
    "RotateRefreshTokens": true,
    "ClockSkewSeconds": 60,
    "PrivateKeyPath": "",
    "PrivateKeyPem": "",
    "PrivateKeyEncrypted": "",
    "RefreshTokenEncryptedKey": ""
  },

  "_security_comment": "=== SECURITY CONFIGURATION ===",
  "DataProtection": {
    "_comment": "KeyPath: where the Data Protection key ring is stored. Leave empty for default: %LOCALAPPDATA%/AuthSystem/Keys",
    "KeyPath": "",
    "Certificate": {
      "_comment": "Only used when SecretManagement:StorageMode = Certificate. Prefer PasswordEnvironmentVariable over storing Password here.",
      "PfxPath": "",
      "Password": "",
      "PasswordEnvironmentVariable": "AUTH_DP_CERT_PASSWORD",
      "Thumbprint": "",
      "AdditionalPfxPaths": []
    }
  },
  "SecretManagement": {
    "_comment": "StorageMode: PlainText (default) | Certificate | Dpapi. Keys auto-generate on first startup; disable AutoGenerateKeys after initial setup in production.",
    "StorageMode": "PlainText",
    "SecretFilePath": "",
    "PlainTextTargetFile": "appsettings.Production.json",
    "AutoGenerateKeys": true,
    "EnableAdminApi": false,
    "RequiredPermission": "secrets.manage"
  },

  "_password_comment": "=== PASSWORD POLICY (Argon2id - OWASP Recommended) ===",
  "Password": {
    "MinimumLength": 6,
    "RequireUppercase": true,
    "RequireLowercase": true,
    "RequireDigit": true,
    "RequireSpecialCharacter": true,
    "HistoryCount": 3,
    "ExpirationDays": 0,
    "MaxFailedAttempts": 5,
    "LockoutDurationMinutes": 15,
    "Argon2MemorySize": 19456,
    "Argon2Iterations": 2,
    "Argon2Parallelism": 1,
    "SaltSize": 16,
    "HashSize": 32
  },

  "_gateway_comment": "=== API GATEWAY PROTECTION ===",
  "Gateway": {
    "_comment": "ExpectedToken is auto-generated and loaded from DPAPI secrets file on first startup",
    "TokenHeaderName": "X-Gateway-Token",
    "ValidationEnabled": true,
    "ExemptPaths": [
      "/.well-known/",
      "/health",
      "/ready",
      "/swagger",
      "/openapi"
    ]
  },

  "_session_comment": "=== SESSION MANAGEMENT ===",
  "Session": {
    "LifetimeHours": 24,
    "ExtendOnActivity": true,
    "ExtensionHours": 1,
    "MaxConcurrentSessions": 5,
    "TerminateOldestOnMax": true,
    "IdleTimeoutMinutes": 30
  },

  "_email_comment": "=== EMAIL SERVICE ===",
  "Email": {
    "_comment": "Configure SMTP for password reset and email verification. Set Enabled=true when ready.",
    "SmtpHost": "{{SMTP_HOST}}",
    "SmtpPort": 587,
    "UseSsl": true,
    "Username": "{{SMTP_USERNAME}}",
    "Password": "Email__Password",
    "SenderEmail": "{{SENDER_EMAIL}}",
    "SenderName": "Auth System",
    "OtpExpirationMinutes": 3,
    "RateLimitWindowSeconds": 60,
    "MaxOtpRequestsPerWindow": 3,
    "Enabled": false
  },

  "_externalauth_comment": "=== EXTERNAL AUTHENTICATION PROVIDERS ===",
  "ExternalAuth": {
    "Google": {
      "Enabled": true,
      "ClientId": "{{GOOGLE_CLIENT_ID}}"
    }
  },

  "_cors_comment": "=== CORS CONFIGURATION (OWASP A02) ===",
  "Cors": {
    "_comment": "REQUIRED for production: Specify allowed origins. Empty array + non-dev environment = startup error",
    "AllowedOrigins": [
      "{{FRONTEND_ORIGIN_1}}",
      "{{FRONTEND_ORIGIN_2}}"
    ],
    "AllowCredentials": true
  },

  "_ratelimit_comment": "=== RATE LIMITING ===",
  "RateLimiting": {
    "EnableRateLimiting": true,
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 10,
    "LoginPermitLimit": 5,
    "LoginWindowSeconds": 60
  },

  "_logging_comment": "=== STRUCTURED LOGGING (Serilog) ===",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/auth-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  }
}
