{
	"info": {
		"_postman_id": "auth-system-v1",
		"name": "Auth System API v1",
		"description": "Complete Postman collection for testing all Auth System API endpoints.\n\n## Authentication\nMost endpoints require JWT Bearer authentication. Use the Login endpoint first to obtain tokens.\n\n## Variables\n- `baseUrl`: API base URL (default: http://localhost:5000)\n- `accessToken`: JWT access token (auto-set after login)\n- `refreshToken`: Refresh token (auto-set after login)\n- `userId`: Current user ID (auto-set after login)\n\n## Argon2id Hashing\nAll secrets, tokens, and API keys are hashed using Argon2id algorithm.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5000",
			"type": "string"
		},
		{
			"key": "accessToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "refreshToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "userId",
			"value": "",
			"type": "string"
		},
		{
			"key": "testUserId",
			"value": "",
			"type": "string"
		},
		{
			"key": "testRoleId",
			"value": "",
			"type": "string"
		},
		{
			"key": "testApiKeyId",
			"value": "",
			"type": "string"
		},
		{
			"key": "testSessionId",
			"value": "",
			"type": "string"
		},
		{
			"key": "applicationId",
			"value": "",
			"type": "string"
		},
		{
			"key": "resetToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "twoFactorSecret",
			"value": "",
			"type": "string"
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{accessToken}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "Discovery",
			"description": "OpenID Connect Discovery endpoints for OIDC/OAuth2 configuration",
			"item": [
				{
					"name": "OpenID Configuration",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/.well-known/openid-configuration",
							"host": ["{{baseUrl}}"],
							"path": [".well-known", "openid-configuration"]
						},
						"description": "Returns OpenID Connect discovery document with all supported endpoints and capabilities."
					},
					"response": []
				},
				{
					"name": "JWKS (JSON Web Key Set)",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/.well-known/jwks.json",
							"host": ["{{baseUrl}}"],
							"path": [".well-known", "jwks.json"]
						},
						"description": "Returns the JSON Web Key Set containing public keys for token verification."
					},
					"response": []
				},
				{
					"name": "Public Key (PEM)",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/.well-known/public-key.pem",
							"host": ["{{baseUrl}}"],
							"path": [".well-known", "public-key.pem"]
						},
						"description": "Returns the RSA public key in PEM format for token verification."
					},
					"response": []
				}
			]
		},
		{
			"name": "Authentication",
			"description": "Core authentication endpoints: login, logout, token refresh, password management",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.accessToken) {",
									"        pm.collectionVariables.set(\"accessToken\", jsonData.accessToken);",
									"    }",
									"    if (jsonData.refreshToken) {",
									"        pm.collectionVariables.set(\"refreshToken\", jsonData.refreshToken);",
									"    }",
									"    if (jsonData.user && jsonData.user.id) {",
									"        pm.collectionVariables.set(\"userId\", jsonData.user.id);",
									"    }",
									"    pm.test(\"Login successful\", function () {",
									"        pm.expect(jsonData.accessToken).to.be.a('string');",
									"        pm.expect(jsonData.refreshToken).to.be.a('string');",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@example.com\",\n    \"password\": \"Admin123!\",\n    \"deviceId\": \"postman-test-device\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "login"]
						},
						"description": "Authenticates a user and returns JWT access token and refresh token.\n\nPassword is verified using Argon2id hashing."
					},
					"response": []
				},
				{
					"name": "Refresh Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.accessToken) {",
									"        pm.collectionVariables.set(\"accessToken\", jsonData.accessToken);",
									"    }",
									"    if (jsonData.refreshToken) {",
									"        pm.collectionVariables.set(\"refreshToken\", jsonData.refreshToken);",
									"    }",
									"    pm.test(\"Token refresh successful\", function () {",
									"        pm.expect(jsonData.accessToken).to.be.a('string');",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"refreshToken\": \"{{refreshToken}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/refresh",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "refresh"]
						},
						"description": "Exchanges a valid refresh token for a new access token.\n\nRefresh token is looked up using Argon2id hash."
					},
					"response": []
				},
				{
					"name": "Logout (Current Device)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"refreshToken\": \"{{refreshToken}}\",\n    \"logoutAllDevices\": false\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/logout",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "logout"]
						},
						"description": "Logs out the current device by revoking the refresh token and blacklisting the access token."
					},
					"response": []
				},
				{
					"name": "Logout (All Devices)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"logoutAllDevices\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/logout",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "logout"]
						},
						"description": "Logs out from all devices by revoking all refresh tokens for the user."
					},
					"response": []
				},
				{
					"name": "Change Password",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"currentPassword\": \"OldPassword123!\",\n    \"newPassword\": \"NewPassword456!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/change-password",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "change-password"]
						},
						"description": "Changes the authenticated user's password.\n\nPassword history is checked to prevent reuse. Both old and new passwords are hashed with Argon2id."
					},
					"response": []
				},
				{
					"name": "Forgot Password",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.token) {",
									"        pm.collectionVariables.set(\"resetToken\", jsonData.token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"user@example.com\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/forgot-password",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "forgot-password"]
						},
						"description": "Initiates password reset flow by generating a reset token.\n\nThe token is hashed with Argon2id before storage. In production, the token would be sent via email."
					},
					"response": []
				},
				{
					"name": "Reset Password",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"token\": \"{{resetToken}}\",\n    \"newPassword\": \"NewSecurePassword123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/reset-password",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "reset-password"]
						},
						"description": "Resets password using a valid reset token.\n\nToken is verified using Argon2id hash lookup. All existing sessions are terminated."
					},
					"response": []
				},
				{
					"name": "Get Current User (Me)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/me",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "me"]
						},
						"description": "Returns information about the currently authenticated user from the JWT claims."
					},
					"response": []
				},
				{
					"name": "Revoke Token",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"token\": \"{{refreshToken}}\",\n    \"tokenTypeHint\": \"refresh_token\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/revoke",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "revoke"]
						},
						"description": "Revokes a token (access or refresh).\n\nTokenTypeHint can be 'access_token' or 'refresh_token'."
					},
					"response": []
				},
				{
					"name": "Introspect Token",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"token\": \"{{accessToken}}\",\n    \"tokenTypeHint\": \"access_token\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/introspect",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "introspect"]
						},
						"description": "Introspects a token to check if it's active and retrieve its claims.\n\nReturns token metadata including expiration, subject, roles, and permissions."
					},
					"response": []
				},
				{
					"name": "Send Email Verification",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/send-verification-email",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "send-verification-email"]
						},
						"description": "Sends a 6-digit OTP to the authenticated user's email for verification.\n\nRequires authentication. OTP expires in 15 minutes.\nRate limited to 3 requests per 60 seconds.\n\nOTP is hashed with Argon2id before storage."
					},
					"response": []
				},
				{
					"name": "Verify Email",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"userId\": \"{{userId}}\",\n    \"otp\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/verify-email",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "verify-email"]
						},
						"description": "Verifies a user's email using the 6-digit OTP sent to their email.\n\nOTP is verified using Argon2id hash comparison.\nMax 5 attempts per OTP. After 5 failed attempts, a new OTP must be requested."
					},
					"response": []
				},
				{
					"name": "Resend Email Verification",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"user@example.com\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/resend-verification-email",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "resend-verification-email"]
						},
						"description": "Resends the email verification OTP to the specified email address.\n\nCan be used when user hasn't received the OTP or it has expired.\nRate limited to 3 requests per 60 seconds per email.\n\nReturns same response for valid/invalid emails to prevent enumeration."
					},
					"response": []
				}
			]
		},
		{
			"name": "Sessions",
			"description": "Session management endpoints for viewing and terminating active sessions",
			"item": [
				{
					"name": "Get Active Sessions",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (Array.isArray(jsonData) && jsonData.length > 0) {",
									"        pm.collectionVariables.set(\"testSessionId\", jsonData[0].id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/sessions",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "sessions"]
						},
						"description": "Returns list of active sessions for the authenticated user."
					},
					"response": []
				},
				{
					"name": "Terminate Session",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/sessions/{{testSessionId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "sessions", "{{testSessionId}}"]
						},
						"description": "Terminates a specific session by ID."
					},
					"response": []
				},
				{
					"name": "Terminate All Sessions",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/sessions",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "sessions"]
						},
						"description": "Terminates all sessions except the current one."
					},
					"response": []
				}
			]
		},
		{
			"name": "Two-Factor Authentication",
			"description": "2FA setup and management using TOTP (Time-based One-Time Password)",
			"item": [
				{
					"name": "Setup 2FA",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.secret) {",
									"        pm.collectionVariables.set(\"twoFactorSecret\", jsonData.secret);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/2fa/setup",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "2fa", "setup"]
						},
						"description": "Initiates 2FA setup and returns the secret and QR code URI.\n\nThe secret should be added to an authenticator app (Google Authenticator, Authy, etc.)."
					},
					"response": []
				},
				{
					"name": "Enable 2FA",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"code\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/2fa/enable",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "2fa", "enable"]
						},
						"description": "Enables 2FA by verifying a TOTP code from the authenticator app.\n\nReturns backup recovery codes. Recovery codes are hashed with Argon2id before storage."
					},
					"response": []
				},
				{
					"name": "Disable 2FA",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"code\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/2fa/disable",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "2fa", "disable"]
						},
						"description": "Disables 2FA by verifying a valid TOTP code.\n\nRequires a valid code to prevent unauthorized disabling."
					},
					"response": []
				}
			]
		},
		{
			"name": "Users",
			"description": "User management endpoints (requires users:* permissions)",
			"item": [
				{
					"name": "Get Users (Paginated)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/users?pageNumber=1&pageSize=20",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "users"],
							"query": [
								{
									"key": "pageNumber",
									"value": "1"
								},
								{
									"key": "pageSize",
									"value": "20"
								},
								{
									"key": "searchTerm",
									"value": "",
									"disabled": true
								}
							]
						},
						"description": "Returns paginated list of users.\n\nRequires 'users:read' permission."
					},
					"response": []
				},
				{
					"name": "Get User by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/users/{{testUserId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "users", "{{testUserId}}"]
						},
						"description": "Returns a specific user by ID.\n\nRequires 'users:read' permission."
					},
					"response": []
				},
				{
					"name": "Create User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.id) {",
									"        pm.collectionVariables.set(\"testUserId\", jsonData.id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"newuser@example.com\",\n    \"password\": \"SecurePassword123!\",\n    \"firstName\": \"John\",\n    \"lastName\": \"Doe\",\n    \"displayName\": \"John Doe\",\n    \"phoneNumber\": \"+1234567890\",\n    \"preferredLanguage\": \"en\",\n    \"timeZone\": \"America/New_York\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/users",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "users"]
