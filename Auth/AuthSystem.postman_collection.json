			]
		},
		{
			"name": "API Key Management",
			"description": "API Key CRUD operations for service-to-service authentication.\n\n**Required Permission:** `apikeys:*`",
			"item": [
				{
					"name": "Get All API Keys",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/{{apiVersion}}/apikeys?applicationId={{applicationId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "{{apiVersion}}", "apikeys"],
							"query": [
								{
									"key": "applicationId",
									"value": "{{applicationId}}",
									"description": "Application ID (required)"
								}
							]
						},
						"description": "Returns all API keys for an application. The actual key values are not returned for security.\n\n**Required Permission:** `apikeys:read`"
					},
					"response": []
				},
				{
					"name": "Create API Key",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set('apiKeyId', jsonData.apiKey.id);",
									"    console.log('New API Key ID saved: ' + jsonData.apiKey.id);",
									"    console.log('IMPORTANT: Save the plainTextKey - it will not be shown again!');",
									"    console.log('Key: ' + jsonData.plainTextKey);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
