{
	"info": {
		"_postman_id": "auth-system-collection-v1",
		"name": "AuthSystem API",
		"description": "Complete API collection for the Enterprise Authentication System.\n\n## Getting Started\n1. Set the `baseUrl` variable to your API endpoint (default: http://localhost:5000)\n2. Use the Login endpoint to authenticate\n3. The access token will be automatically saved and used for subsequent requests\n\n## Authentication\nMost endpoints require a valid JWT token. After logging in, the token is automatically applied to protected endpoints via the Authorization header.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5000",
			"type": "string"
		},
		{
			"key": "apiVersion",
			"value": "v1",
			"type": "string"
		},
		{
			"key": "accessToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "refreshToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "userId",
			"value": "",
			"type": "string"
		},
		{
			"key": "applicationId",
			"value": "",
			"type": "string"
		},
		{
			"key": "roleId",
			"value": "",
			"type": "string"
		},
		{
			"key": "apiKeyId",
			"value": "",
			"type": "string"
		},
		{
			"key": "sessionId",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Discovery (OIDC)",
			"description": "OpenID Connect Discovery endpoints for token validation and configuration.",
			"item": [
				{
					"name": "Get OpenID Configuration",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/.well-known/openid-configuration",
							"host": ["{{baseUrl}}"],
							"path": [".well-known", "openid-configuration"]
						},
						"description": "Returns the OpenID Connect Discovery Document with all supported endpoints and capabilities."
					},
					"response": []
				},
				{
					"name": "Get JWKS (JSON Web Key Set)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/.well-known/jwks.json",
							"host": ["{{baseUrl}}"],
							"path": [".well-known", "jwks.json"]
						},
						"description": "Returns the JSON Web Key Set used for token signature verification."
					},
					"response": []
				},
				{
					"name": "Get Public Key (PEM)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/.well-known/public-key.pem",
							"host": ["{{baseUrl}}"],
							"path": [".well-known", "public-key.pem"]
						},
						"description": "Returns the public key in PEM format for token verification."
					},
					"response": []
				}
			]
		},
		{
			"name": "Authentication",
			"description": "Authentication endpoints for login, logout, and token management.",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set('accessToken', jsonData.token.accessToken);",
									"    pm.collectionVariables.set('refreshToken', jsonData.token.refreshToken);",
									"    pm.collectionVariables.set('userId', jsonData.user.id);",
									"    console.log('Tokens saved successfully');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@example.com\",\n    \"password\": \"Admin@123\",\n    \"deviceId\": \"postman-client\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/{{apiVersion}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "{{apiVersion}}", "auth", "login"]
						},
						"description": "Authenticates a user with email and password. Returns JWT access token, refresh token, and user information.\n\n**Rate Limited:** This endpoint is rate-limited to prevent brute force attacks."
					},
					"response": []
				},
				{
					"name": "Refresh Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set('accessToken', jsonData.accessToken);",
									"    pm.collectionVariables.set('refreshToken', jsonData.refreshToken);",
									"    console.log('Tokens refreshed successfully');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"refreshToken\": \"{{refreshToken}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/{{apiVersion}}/auth/refresh",
							"host": ["{{baseUrl}}"],
							"path": ["api", "{{apiVersion}}", "auth", "refresh"]
						},
						"description": "Refreshes an expired access token using a valid refresh token."
					},
					"response": []
				},
				{
					"name": "Get Current User",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/{{apiVersion}}/auth/me",
							"host": ["{{baseUrl}}"],
							"path": ["api", "{{apiVersion}}", "auth", "me"]
						},
						"description": "Returns the current authenticated user's information including roles and permissions."
					},
					"response": []
				},
				{
					"name": "Logout (Current Device)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"refreshToken\": \"{{refreshToken}}\",\n    \"logoutAllDevices\": false\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/{{apiVersion}}/auth/logout",
							"host": ["{{baseUrl}}"],
							"path": ["api", "{{apiVersion}}", "auth", "logout"]
						},
						"description": "Logs out the current user and revokes the specified refresh token."
					},
					"response": []
				},
				{
					"name": "Logout (All Devices)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"logoutAllDevices\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/{{apiVersion}}/auth/logout",
							"host": ["{{baseUrl}}"],
							"path": ["api", "{{apiVersion}}", "auth", "logout"]
						},
						"description": "Logs out the user from all devices by revoking all refresh tokens."
					},
					"response": []
				},
				{
					"name": "Send Email Verification",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/{{apiVersion}}/auth/send-verification-email",
							"host": ["{{baseUrl}}"],
							"path": ["api", "{{apiVersion}}", "auth", "send-verification-email"]
						},
						"description": "Sends a 6-digit OTP to the authenticated user's email for verification.\n\nOTP expires in 15 minutes. Rate limited to 3 requests per 60 seconds."
					},
					"response": []
				},
				{
					"name": "Verify Email",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"userId\": \"{{userId}}\",\n    \"otp\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/{{apiVersion}}/auth/verify-email",
							"host": ["{{baseUrl}}"],
							"path": ["api", "{{apiVersion}}", "auth", "verify-email"]
						},
						"description": "Verifies a user's email using the 6-digit OTP sent to their email.\n\nMax 5 attempts per OTP."
					},
					"response": []
				},
				{
					"name": "Resend Email Verification",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"user@example.com\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/{{apiVersion}}/auth/resend-verification-email",
							"host": ["{{baseUrl}}"],
							"path": ["api", "{{apiVersion}}", "auth", "resend-verification-email"]
						},
						"description": "Resends the email verification OTP to the specified email address.\n\nRate limited to 3 requests per 60 seconds per email."
					},
					"response": []
				},
				{
					"name": "Change Password",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"currentPassword\": \"CurrentPass@123\",\n    \"newPassword\": \"NewSecurePass@456\",\n    \"confirmNewPassword\": \"NewSecurePass@456\",\n    \"terminateSessions\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/{{apiVersion}}/auth/change-password",
							"host": ["{{baseUrl}}"],
							"path": ["api", "{{apiVersion}}", "auth", "change-password"]
						},
						"description": "Changes the authenticated user's password.\n\n**Requires:** Authentication\n\n**Password Requirements:**\n- Minimum 12 characters\n- At least one uppercase letter\n- At least one lowercase letter\n- At least one digit\n- At least one special character\n\n**Security:** All existing sessions will be terminated after password change."
					},
					"response": []
				},
				{
					"name": "Forgot Password",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"user@example.com\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/{{apiVersion}}/auth/forgot-password",
							"host": ["{{baseUrl}}"],
							"path": ["api", "{{apiVersion}}", "auth", "forgot-password"]
						},
						"description": "Initiates a password reset flow by generating a reset token.\n\nThe reset token is returned in the response (in production, sent via email).\n\n**Rate Limited:** To prevent abuse."
					},
					"response": []
				},
				{
					"name": "Reset Password",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"token\": \"reset-token-from-forgot-password\",\n    \"newPassword\": \"NewSecurePass@789\",\n    \"confirmNewPassword\": \"NewSecurePass@789\",\n    \"terminateSessions\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/{{apiVersion}}/auth/reset-password",
							"host": ["{{baseUrl}}"],
							"path": ["api", "{{apiVersion}}", "auth", "reset-password"]
						},
						"description": "Resets a user's password using a valid reset token.\n\nThe token is obtained from the forgot-password endpoint."
					},
					"response": []
				},
				{
					"name": "Get Sessions",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/{{apiVersion}}/auth/sessions",
							"host": ["{{baseUrl}}"],
							"path": ["api", "{{apiVersion}}", "auth", "sessions"]
						},
						"description": "Returns a list of the authenticated user's active sessions including device info, IP address, and activity timestamps."
					},
					"response": []
				},
				{
					"name": "Terminate Session",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/{{apiVersion}}/auth/sessions/{{sessionId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "{{apiVersion}}", "auth", "sessions", "{{sessionId}}"]
						},
						"description": "Terminates a specific session by its ID."
					},
					"response": []
				},
				{
					"name": "Terminate All Sessions",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/{{apiVersion}}/auth/sessions",
							"host": ["{{baseUrl}}"],
							"path": ["api", "{{apiVersion}}", "auth", "sessions"]
						},
						"description": "Terminates all sessions except the current one. Returns the count of terminated sessions."
					},
					"response": []
				},
				{
					"name": "Revoke Token",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"token\": \"{{accessToken}}\",\n    \"tokenTypeHint\": \"access_token\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/{{apiVersion}}/auth/revoke",
							"host": ["{{baseUrl}}"],
							"path": ["api", "{{apiVersion}}", "auth", "revoke"]
						},
						"description": "Revokes an access or refresh token (RFC 7009).\n\n**tokenTypeHint:** 'access_token' or 'refresh_token'"
					},
					"response": []
				},
				{
					"name": "Introspect Token",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"token\": \"{{accessToken}}\",\n    \"tokenTypeHint\": \"access_token\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/{{apiVersion}}/auth/introspect",
							"host": ["{{baseUrl}}"],
							"path": ["api", "{{apiVersion}}", "auth", "introspect"]
						},
						"description": "Introspects a token and returns its metadata (RFC 7662).\n\nReturns active status, expiration, subject, and other claims."
					},
					"response": []
				}
			]
		},
		{
			"name": "Two-Factor Authentication",
			"description": "Two-factor authentication (2FA) setup and management using TOTP.",
			"item": [
				{
					"name": "Setup 2FA",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/{{apiVersion}}/auth/2fa/setup",
							"host": ["{{baseUrl}}"],
							"path": ["api", "{{apiVersion}}", "auth", "2fa", "setup"]
						},
						"description": "Initializes 2FA setup by generating a secret and QR code URI.\n\nUse the QR code with an authenticator app (Google Authenticator, Authy, etc.)."
					},
					"response": []
				},
				{
					"name": "Enable 2FA",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"code\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/{{apiVersion}}/auth/2fa/enable",
							"host": ["{{baseUrl}}"],
							"path": ["api", "{{apiVersion}}", "auth", "2fa", "enable"]
						},
						"description": "Enables 2FA after verifying a valid TOTP code from the authenticator app.\n\nReturns recovery codes for backup access."
					},
					"response": []
				},
				{
					"name": "Disable 2FA",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"code\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/{{apiVersion}}/auth/2fa/disable",
							"host": ["{{baseUrl}}"],
							"path": ["api", "{{apiVersion}}", "auth", "2fa", "disable"]
						},
						"description": "Disables 2FA for the user's account.\n\nRequires a valid TOTP code to confirm the action."
					},
					"response": []
				}
			]
		},
		{
			"name": "User Management",
			"description": "User CRUD operations and role assignment.\n\n**Required Permission:** `users:*`",
			"item": [
				{
					"name": "Get All Users (Paginated)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/{{apiVersion}}/users?pageNumber=1&pageSize=20",
							"host": ["{{baseUrl}}"],
							"path": ["api", "{{apiVersion}}", "users"],
							"query": [
								{
									"key": "pageNumber",
									"value": "1",
									"description": "Page number (default: 1)"
								},
								{
									"key": "pageSize",
									"value": "20",
									"description": "Items per page (default: 20)"
								},
								{
									"key": "searchTerm",
									"value": "",
									"description": "Search by email, name, etc.",
									"disabled": true
								}
							]
						},
						"description": "Returns a paginated list of users.\n\n**Required Permission:** `users:read`"
					},
					"response": []
				},
				{
					"name": "Get User by ID",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/{{apiVersion}}/users/{{userId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "{{apiVersion}}", "users", "{{userId}}"]
						},
						"description": "Returns a specific user by their ID.\n\n**Required Permission:** `users:read`"
					},
					"response": []
				},
				{
					"name": "Create User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set('userId', jsonData.id);",
									"    console.log('New user ID saved: ' + jsonData.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
