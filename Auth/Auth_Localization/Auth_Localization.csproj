<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\AuthMessages.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>AuthMessages.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Errors\DomainErrors.resx" />
    <EmbeddedResource Update="Resources\Errors\DomainErrors.*.resx" />
    <EmbeddedResource Update="Resources\Validation\ValidationMessages.resx" />
    <EmbeddedResource Update="Resources\Validation\ValidationMessages.*.resx" />
    <EmbeddedResource Update="Resources\Middleware\MiddlewareMessages.resx" />
    <EmbeddedResource Update="Resources\Middleware\MiddlewareMessages.*.resx" />
    <EmbeddedResource Update="Resources\Email\EmailTemplates.resx" />
    <EmbeddedResource Update="Resources\Email\EmailTemplates.*.resx" />
  </ItemGroup>

</Project>
