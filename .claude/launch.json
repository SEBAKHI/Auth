{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "Auth/Auth_API/Auth_API.csproj",
        "--launch-profile",
        "http"
      ],
      "port": 5100,
      "autoPort": false
    },
    {
      "name": "api-https",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "Auth/Auth_API/Auth_API.csproj",
        "--launch-profile",
        "https"
      ],
      "port": 5101,
      "url": "https://localhost:5101",
      "autoPort": false
    },
    {
      "name": "accounts",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["-C", "Auth_UI", "run", "dev:accounts"],
      "port": 5174,
      "autoPort": false
    },
    {
      "name": "console",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["-C", "Auth_UI", "run", "dev"],
      "port": 5173,
      "autoPort": false
    }
  ]
}
