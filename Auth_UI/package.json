{
  "name": "auth-ui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @authsystem/console dev",
    "dev:accounts": "pnpm --filter @authsystem/accounts dev",
    "build": "pnpm -r build",
    "build:test": "pnpm -r build:test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "gen:api": "openapi-typescript http://localhost:5100/openapi/v1.json -o packages/api/src/schema.d.ts",
    "gen:error-codes": "node scripts/generate-error-codes.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:changed": "vitest run --coverage && node ../Tools/verify-changed-coverage.mjs --frontend Auth_UI/coverage/coverage-final.json --threshold 90",
    "e2e": "playwright test",
    "e2e:isolated": "pnpm --filter @authsystem/console build:test && pnpm --filter @authsystem/accounts build:test && playwright test --config playwright.isolated.config.ts",
    "e2e:production": "pnpm build:test && playwright test --config playwright.production.config.ts",
    "e2e:harness": "node scripts/build-harness.mjs && playwright test --config playwright.harness.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "@vitest/coverage-istanbul": "4.1.9",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.21.0",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^4.1.9"
  }
}
