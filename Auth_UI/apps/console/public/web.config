<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for hosting the Auth Console SPA as static files.
  - SPA fallback: any non-file route is served index.html so client-side
    routing (React Router) works on refresh / deep links.
  - Security headers, including a CSP whose connect-src MUST include the
    deployed Auth API origin (keep in sync with VITE_API_BASE_URL).
  - The API origin below is a PLACEHOLDER (RFC 2606, resolves nowhere) and is NOT
    edited by hand. scripts/seal-web-config.mjs rewrites it in dist/web.config
    after every build from VITE_API_BASE_URL, so the policy cannot drift from the
    origin baked into the bundle. Put your own origin in
    apps/console/.env.production.local, which git does not track; a build still
    carrying the placeholder is refused instead of shipped.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- /favicon.ico: browsers and feed readers ask for it at the root, whatever the page
             names, and the SPA fallback below answered it with index.html (200 text/html).
             It is the platform's tab icon, at the address the API keeps it
             (packages/api/src/platform-favicon.ts); the origin is sealed like the policy's. -->
        <rule name="Favicon" stopProcessing="true">
          <match url="^favicon.ico$" />
          <action type="Redirect" url="https://auth.example.com/uploads/images/platform-favicon.png" redirectType="Found" />
        </rule>
        <rule name="SPA Fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/api/" negate="true" />
            <!-- A deploy removes the previous build's hashed chunks. Without this
                 exclusion a tab still running the old index.html requests a deleted
                 /assets/*.js and gets 200 text/html back, which the module loader
                 rejects with a blank screen — and the 365-day rule below then caches
                 that broken response under a .js URL. Let it 404 honestly instead;
                 RouteErrorBoundary turns the honest failure into one reload. -->
            <add input="{REQUEST_URI}" pattern="^/assets/" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
        <!-- img-src includes the Auth API origin: uploaded images (avatars, logos) are served
             from its /uploads/images path (ImageStorage:PublicBaseUrl). font-src names it too:
             the platform's own fonts (Platform settings > Fonts) are WOFF2 files under
             /uploads/images/fonts/, sent with Access-Control-Allow-Origin: *. The notification
             preview no longer inherits this CSP: it is /email-preview.html, with a policy of
             its own (the <location> at the end of this file), whose img-src names the same
             origin for the email layout's logo (seed 11_NotificationLayouts.sql). It used to
             name a second, external host for a hardcoded brand logo; that logo is gone. A
             layout an admin has customised to hotlink an outside host needs that host added
             to the preview's img-src, deliberately.

             No Google address appears in this policy (card S02 PR D). The "Continue with Google"
             button on /login is the app's own: a click opens a popup to Google's authorization
             page (a popup's navigation is not governed by this policy), Google returns the
             person to /google-callback.html (the <location> at the end), and the code is
             exchanged through the API. No Google script, stylesheet or frame is ever loaded into
             these pages, so none of script-src, style-src, connect-src or frame-src names
             Google, and apps/console/src/console-login-surface.test.ts keeps it that way. Until
             then a SPA's single policy made Google a script source on every console page,
             secrets and audit logs included, for the one button on /login.

             frame-src MUST keep 'self': the notification preview frames /email-preview.html,
             and the sign-in page design previews frame /login-design-frame.html, documents
             on this origin with policies of their own (the <location>s at the end). frame-src also bounds where that frame can be sent by
             an email (a meta refresh): another origin is refused here. A page of this origin
             refuses to be framed itself (X-Frame-Options DENY and frame-ancestors 'none' above),
             so only /email-preview.html can load again, and its second "ready" finds no listener.

             DELIBERATELY ABSENT - Apple. The apple provider row is seeded disabled
             (09_ExternalAuthProviders.sql), so AppleSignIn renders nothing and a script source for
             it would be surface area for a feature nobody can reach. Whoever enables that row must
             add https://appleid.cdn-apple.com to script-src and https://appleid.apple.com to
             connect-src here, or the button will render and fail on click.

             Inline styles (card S02). 'unsafe-inline' in style-src lets anyone who can inject
             markup - not even a script - restyle any page: hide a warning, cover a button.
             It goes in two stages. Stage A (now): the policy below still carries it, and the
             Report-Only header after it carries the target: style-src with no
             'unsafe-inline', only the hashes of the constant <style> texts the libraries
             inject. A browser reports every inline style that target would refuse, and
             blocks nothing. Stage B, once a deployment has shown zero such reports in Chrome
             and Firefox: the enforced style-src becomes the Report-Only one, and the
             Report-Only header goes.
             The hashes are copied from csp/inline-styles.json, which `pnpm csp:collect`
             computes from the installed libraries; never compute or edit one here by hand:
             src/csp-style-policy.test.ts refuses any difference from that file, and
             scripts/seal-web-config.mjs refuses a build whose bundle lacks one of the texts
             or holds a style site csp/bundle-style-sites.json does not count. Stylesheets
             whose text is computed at run time (the editor, the charts, the dialogs' scroll
             lock, the platform appearance) are adopted stylesheets, which CSP does not
             check (packages/ui/src/hooks/use-adopted-style-sheet.ts, patches/).
             The Report-Only header is this policy with that style-src and without
             frame-ancestors, which the policy above already enforces. -->
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://auth.example.com; font-src 'self' data: https://auth.example.com; connect-src 'self' https://auth.example.com; frame-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" />
        <add name="Content-Security-Policy-Report-Only" value="default-src 'self'; script-src 'self'; style-src 'self' 'sha256-47DEQpj8HBSa+/TImW+5JCeuQeRkm5NMpJWZG3hSuFU=' 'sha256-vGQdhYJbTuF+M8iCn1IZCHpdkiICocWHDq4qnQF4Rjw=' 'sha256-441zG27rExd4/il+NvIqyL8zFx5XmyNQtE381kSkUJk=' 'sha256-StEaX+se6YS7pqjzrzMIA0KaX9zF/8zAhvQXZAe5epY='; img-src 'self' data: https://auth.example.com; font-src 'self' data: https://auth.example.com; connect-src 'self' https://auth.example.com; frame-src 'self'; object-src 'none'; base-uri 'self'" />
      </customHeaders>
    </httpProtocol>

    <staticContent>
      <!-- The SPA shell must always be revalidated. A stale index.html can point
           at a removed hashed bundle and leave the application completely blank. -->
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
  </system.webServer>

  <!-- Vite fingerprints everything under assets, so those immutable files can
       keep the long cache without pinning index.html to an old deployment. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
      <!-- The sign-in page design frame (login-design-frame.html) is sandboxed without
           allow-same-origin, so its origin is opaque and its stylesheet and the platform's
           fonts it loads from here are cross-origin requests: without this header the
           browser refuses them. Every file here is public and fingerprinted, and the header
           allows no credentials. -->
      <httpProtocol>
        <customHeaders>
          <add name="Access-Control-Allow-Origin" value="*" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

  <!-- The notification preview document (EmailPreviewFrame, card S02). The console frames it
       with sandbox="allow-scripts" (an opaque origin: no console storage, token or cookie)
       and posts the email's HTML to it once, after it says "ready". An email needs inline
       styles; the console's own policy refuses them, so this one file gets its own:
         - script-src: the hash of the receiver script in public/email-preview.html and
           nothing else, so an email's scripts and on* handlers do not run. The receiver
           also writes a policy of the document's own before the email (script-src 'none'),
           so they stay refused where this header is missing, and no hash-allowed external
           script is even fetched.
           scripts/seal-web-config.mjs recomputes it from dist/email-preview.html and
           refuses a build where they differ (.gitattributes keeps the file LF);
         - style-src 'unsafe-inline': the email's own styles, which the preview allowed before
           too (its inline document inherited this file's policy) - but no stylesheet from any
           origin, and no network except images: default-src 'none', and img-src 'self', data:
           and the API origin (the layout's logo);
         - base-uri and form-action 'none'.
       Two controls are weaker here, on purpose and only here (card S02, C8): the frame runs
       one script (it was sandbox=""), and X-Frame-Options is SAMEORIGIN instead of DENY, so
       the console can frame it. frame-ancestors 'self' keeps every other origin out, and
       the page has no control and shows nothing until its parent sends it an email.
       Fail-closed: if IIS ignored this element, the console policy above would apply, the
       receiver would be refused, and the console shows an alert instead of the email. -->
  <location path="email-preview.html">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <remove name="Content-Security-Policy" />
          <remove name="Content-Security-Policy-Report-Only" />
          <remove name="X-Frame-Options" />
          <add name="X-Frame-Options" value="SAMEORIGIN" />
          <add name="Content-Security-Policy" value="default-src 'none'; script-src 'sha256-xS+T1xT3XbpWMqAoW2rMPDsmx/PriN7DHTl+FI5X9G0='; style-src 'unsafe-inline'; img-src 'self' data: https://auth.example.com; base-uri 'none'; form-action 'none'; frame-ancestors 'self'" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

  <!-- The frame of a sign-in page design (DesignFrame, packages/ui; the console's design previews). The page frames it
       with sandbox="allow-scripts allow-popups allow-popups-to-escape-sandbox" (an opaque
       origin: no storage, token or cookie of this app) and posts it the design's HTML, the
       appearance's values and the mode once it says "ready". A design is free HTML and CSS
       an administrator wrote, so this one file gets a policy of its own:
         - script-src: the hash of the receiver script in login-design-frame.html and nothing
           else, so a design's scripts and on* handlers do not run.
           scripts/seal-web-config.mjs recomputes it from the built page and refuses a build
           where they differ (.gitattributes keeps the file LF);
         - style-src 'self' 'unsafe-inline': the design's own styles, and the page's
           stylesheet with the shipped fonts (font-src 'self' data: - the build inlines
           the smallest font subsets as data: URIs, as the site policy allows);
         - font-src also names the Auth API origin: the platform's own fonts (Platform
           settings > Fonts), which the receiver registers from the addresses the page sends;
         - img-src https: data:: images by address from any site, besides uploads (owner
           decision Q9);
         - no network otherwise (default-src 'none'), base-uri and form-action 'none'.
       Links open a new tab (the receiver sets target="_blank" rel="noopener"); the sandbox
       has no allow-top-navigation, so a design cannot take the page away. X-Frame-Options is
       SAMEORIGIN instead of DENY so the page can frame it, and frame-ancestors 'self' keeps
       every other origin out. Fail-closed: if IIS ignored this element, the site policy
       would refuse the receiver, the frame never says "ready", and the panel stays plain. -->
  <location path="login-design-frame.html">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <remove name="Content-Security-Policy" />
          <remove name="Content-Security-Policy-Report-Only" />
          <remove name="X-Frame-Options" />
          <add name="X-Frame-Options" value="SAMEORIGIN" />
          <add name="Content-Security-Policy" value="default-src 'none'; script-src 'sha256-IOQTEb9h+UPDdFdkLHtYao8jfrJ8nNLOpz8NjnaInyo='; style-src 'self' 'unsafe-inline'; font-src 'self' data: https://auth.example.com; img-src https: data:; base-uri 'none'; form-action 'none'; frame-ancestors 'self'" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
  <!-- The page Google sends the person back to after the Google sign-in (google-callback.html,
       card S02 PR D). Google appends a one-time code and the sign-in's state to its address; the
       page's one module hands them to the sign-in page, takes them out of the address, and
       closes the window. It keeps the site policy above (its module is a file of this origin,
       so script-src 'self' admits it) and X-Frame-Options DENY, and changes two headers:
         - Cache-Control: no-store, so no cache keeps the answer to an address that held a code.
           clientCache NoControl drops the site's no-cache, which IIS would otherwise send
           beside it;
         - Referrer-Policy: no-referrer, so the request for its module, which the browser makes
           while the code is still in the address, carries no Referer with the code in it (the
           page also says so in a meta tag, for a server without this element).
       The code alone signs nobody in: the API exchanges it only with the PKCE verifier the
       sign-in page kept, and the client secret. -->
  <location path="google-callback.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="NoControl" />
      </staticContent>
      <httpProtocol>
        <customHeaders>
          <remove name="Referrer-Policy" />
          <add name="Referrer-Policy" value="no-referrer" />
          <add name="Cache-Control" value="no-store" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
