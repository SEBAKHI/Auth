<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for hosting the Auth Console SPA as static files.
  - SPA fallback: any non-file route is served index.html so client-side
    routing (React Router) works on refresh / deep links.
  - Security headers, including a CSP whose connect-src MUST include the
    deployed Auth API origin (keep in sync with VITE_API_BASE_URL).
  - The API origin below is a PLACEHOLDER (RFC 2606, resolves nowhere) and is NOT
    edited by hand. scripts/seal-web-config.mjs rewrites it in dist/web.config
    after every build from VITE_API_BASE_URL, so the policy cannot drift from the
    origin baked into the bundle. Put your own origin in
    apps/console/.env.production.local, which git does not track; a build still
    carrying the placeholder is refused instead of shipped.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="SPA Fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/api/" negate="true" />
            <!-- A deploy removes the previous build's hashed chunks. Without this
                 exclusion a tab still running the old index.html requests a deleted
                 /assets/*.js and gets 200 text/html back, which the module loader
                 rejects with a blank screen — and the 365-day rule below then caches
                 that broken response under a .js URL. Let it 404 honestly instead;
                 RouteErrorBoundary turns the honest failure into one reload. -->
            <add input="{REQUEST_URI}" pattern="^/assets/" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
        <!-- img-src includes the Auth API origin: uploaded images (avatars, logos) are served
             from its /uploads/images path (ImageStorage:PublicBaseUrl). That one origin now
             covers the notification-preview iframe too (its srcdoc inherits this CSP): since
             2026-07-31_EmailLayoutLogoPlatformDriven.sql the email layout renders the platform
             logo, which resolves to PlatformSettings.LogoUrl on the API origin. It used to name
             a second, external host for a hardcoded brand logo; that logo is gone. A layout an
             admin has customised to hotlink an outside host needs that host added here,
             deliberately.

             https://accounts.google.com appears in script-src, connect-src AND frame-src for the
             "Continue with Google" button on /login. All three are required: GSI loads its client
             script from that origin, calls back to it, and - once the visitor has approved this
             app - swaps the rendered button for an accounts.google.com/gsi/button IFRAME, which is
             the path that needs frame-src. Note what this costs: a SPA serves one index.html for
             every route, so the header cannot be scoped to /login, and Google becomes a script
             source on every console page including secrets and audit logs. That is a deliberate
             reversal of the earlier decision to keep these origins out of the console; it is the
             price of letting a Google-created administrator in at all, and
             apps/console/src/console-login-surface.test.ts pins it so a later CSP tidy-up cannot
             silently drop it.

             frame-src MUST keep 'self': there was no frame-src directive here before, so frames
             fell back to default-src 'self', and a bare Google-only value would narrow the live
             notification-preview srcdoc iframe described above.

             DELIBERATELY ABSENT - Apple. The apple provider row is seeded disabled
             (09_ExternalAuthProviders.sql), so AppleSignIn renders nothing and a script source for
             it would be surface area for a feature nobody can reach. Whoever enables that row must
             add https://appleid.cdn-apple.com to script-src and https://appleid.apple.com to
             connect-src here, or the button will render and fail on click. -->
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' https://accounts.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://auth.example.com; font-src 'self' data:; connect-src 'self' https://auth.example.com https://accounts.google.com; frame-src 'self' https://accounts.google.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" />
      </customHeaders>
    </httpProtocol>

    <staticContent>
      <!-- The SPA shell must always be revalidated. A stale index.html can point
           at a removed hashed bundle and leave the application completely blank. -->
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
  </system.webServer>

  <!-- Vite fingerprints everything under assets, so those immutable files can
       keep the long cache without pinning index.html to an old deployment. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
