<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for hosting the Auth Console SPA as static files.
  - SPA fallback: any non-file route is served index.html so client-side
    routing (React Router) works on refresh / deep links.
  - Security headers, including a CSP whose connect-src MUST include the
    deployed Auth API origin (keep in sync with VITE_API_BASE_URL).
  - The API origin below is a PLACEHOLDER (RFC 2606, resolves nowhere) and is NOT
    edited by hand. scripts/seal-web-config.mjs rewrites it in dist/web.config
    after every build from VITE_API_BASE_URL, so the policy cannot drift from the
    origin baked into the bundle. Put your own origin in
    apps/console/.env.production.local, which git does not track; a build still
    carrying the placeholder is refused instead of shipped.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="SPA Fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/api/" negate="true" />
            <!-- A deploy removes the previous build's hashed chunks. Without this
                 exclusion a tab still running the old index.html requests a deleted
                 /assets/*.js and gets 200 text/html back, which the module loader
                 rejects with a blank screen — and the 365-day rule below then caches
                 that broken response under a .js URL. Let it 404 honestly instead;
                 RouteErrorBoundary turns the honest failure into one reload. -->
            <add input="{REQUEST_URI}" pattern="^/assets/" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
        <!-- img-src includes the Auth API origin: uploaded images (avatars, logos) are served
             from its /uploads/images path (ImageStorage:PublicBaseUrl). The notification
             preview no longer inherits this CSP: it is /email-preview.html, with a policy of
             its own (the <location> at the end of this file), whose img-src names the same
             origin for the email layout's logo (seed 11_NotificationLayouts.sql). It used to
             name a second, external host for a hardcoded brand logo; that logo is gone. A
             layout an admin has customised to hotlink an outside host needs that host added
             to the preview's img-src, deliberately.

             https://accounts.google.com appears in script-src, connect-src AND frame-src for the
             "Continue with Google" button on /login. All three are required: GSI loads its client
             script from that origin, calls back to it, and - once the visitor has approved this
             app - swaps the rendered button for an accounts.google.com/gsi/button IFRAME, which is
             the path that needs frame-src. Note what this costs: a SPA serves one index.html for
             every route, so the header cannot be scoped to /login, and Google becomes a script
             source on every console page including secrets and audit logs. That is a deliberate
             reversal of the earlier decision to keep these origins out of the console; it is the
             price of letting a Google-created administrator in at all, and
             apps/console/src/console-login-surface.test.ts pins it so a later CSP tidy-up cannot
             silently drop it.

             frame-src MUST keep 'self': the notification preview frames /email-preview.html,
             a document on this origin. frame-src also bounds where that frame can be sent: an
             email that tries to navigate it elsewhere (a meta refresh) is refused here.

             DELIBERATELY ABSENT - Apple. The apple provider row is seeded disabled
             (09_ExternalAuthProviders.sql), so AppleSignIn renders nothing and a script source for
             it would be surface area for a feature nobody can reach. Whoever enables that row must
             add https://appleid.cdn-apple.com to script-src and https://appleid.apple.com to
             connect-src here, or the button will render and fail on click.

             style-src includes accounts.google.com because Google's sign-in script
             fetches its own stylesheet from https://accounts.google.com/gsi/style.
             Admitting the script and its button iframe while refusing that
             stylesheet leaves the button unstyled and logs a violation on every
             page that offers it. Whoever enables Apple should expect the same
             question for appleid.cdn-apple.com.

             Inline styles (card S02). 'unsafe-inline' in style-src lets anyone who can inject
             markup - not even a script - restyle any page: hide a warning, cover a button.
             It goes in two stages. Stage A (now): the policy below still carries it, and the
             Report-Only header after it carries the target: style-src with no
             'unsafe-inline', only the hashes of the constant <style> texts the libraries
             inject. A browser reports every inline style that target would refuse, and
             blocks nothing. Stage B, once the sandbox has shown zero such reports in Chrome
             and Firefox: the enforced style-src becomes the Report-Only one, and the
             Report-Only header goes.
             The hashes are NOT typed by hand. They come from csp/inline-styles.json, which
             `pnpm csp:collect` computes from the installed libraries;
             src/csp-style-policy.test.ts fails until this file carries exactly them, and
             scripts/seal-web-config.mjs refuses a build whose bundle lacks one of the texts
             or holds a style site csp/bundle-style-sites.json does not count. Stylesheets
             whose text is computed at run time (the editor, the charts, the dialogs' scroll
             lock, the platform appearance) are adopted stylesheets, which CSP does not
             check (packages/ui/src/hooks/use-adopted-style-sheet.ts, patches/).
             The Report-Only header is this policy with that style-src and without
             frame-ancestors, which the policy above already enforces. -->
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' https://accounts.google.com; style-src 'self' 'unsafe-inline' https://accounts.google.com; img-src 'self' data: https://auth.example.com; font-src 'self' data:; connect-src 'self' https://auth.example.com https://accounts.google.com; frame-src 'self' https://accounts.google.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" />
        <add name="Content-Security-Policy-Report-Only" value="default-src 'self'; script-src 'self' https://accounts.google.com; style-src 'self' 'sha256-47DEQpj8HBSa+/TImW+5JCeuQeRkm5NMpJWZG3hSuFU=' 'sha256-vGQdhYJbTuF+M8iCn1IZCHpdkiICocWHDq4qnQF4Rjw=' 'sha256-441zG27rExd4/il+NvIqyL8zFx5XmyNQtE381kSkUJk=' 'sha256-StEaX+se6YS7pqjzrzMIA0KaX9zF/8zAhvQXZAe5epY=' https://accounts.google.com; img-src 'self' data: https://auth.example.com; font-src 'self' data:; connect-src 'self' https://auth.example.com https://accounts.google.com; frame-src 'self' https://accounts.google.com; object-src 'none'; base-uri 'self'" />
      </customHeaders>
    </httpProtocol>

    <staticContent>
      <!-- The SPA shell must always be revalidated. A stale index.html can point
           at a removed hashed bundle and leave the application completely blank. -->
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
  </system.webServer>

  <!-- Vite fingerprints everything under assets, so those immutable files can
       keep the long cache without pinning index.html to an old deployment. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- The notification preview document (EmailPreviewFrame, card S02). The console frames it
       with sandbox="allow-scripts" (an opaque origin: no console storage, token or cookie)
       and posts the email's HTML to it once, after it says "ready". An email needs inline
       styles; the console's own policy refuses them, so this one file gets its own:
         - script-src: the hash of the receiver script in public/email-preview.html and
           nothing else, so an email's scripts and on* handlers do not run.
           scripts/seal-web-config.mjs recomputes it from dist/email-preview.html and
           refuses a build where they differ (.gitattributes keeps the file LF);
         - style-src 'unsafe-inline': the email's own styles, which the preview allowed before
           too (its inline document inherited this file's policy) - but no 'self' and no
           network: default-src 'none', and img-src the API origin (the layout's logo) plus data:;
         - base-uri and form-action 'none'.
       Two controls are weaker here, on purpose and only here (card S02, C8): the frame runs
       one script (it was sandbox=""), and X-Frame-Options is SAMEORIGIN instead of DENY, so
       the console can frame it. frame-ancestors 'self' keeps every other origin out, and
       the page has no control and shows nothing until its parent sends it an email.
       Fail-closed: if IIS ignored this element, the console policy above would apply, the
       receiver would be refused, and the console shows an alert instead of the email. -->
  <location path="email-preview.html">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <remove name="Content-Security-Policy" />
          <remove name="Content-Security-Policy-Report-Only" />
          <remove name="X-Frame-Options" />
          <add name="X-Frame-Options" value="SAMEORIGIN" />
          <add name="Content-Security-Policy" value="default-src 'none'; script-src 'sha256-qwYpC21vAm2p8RSBvXIaPtrAZWjh/KF25Yftuw0WK88='; style-src 'unsafe-inline'; img-src 'self' data: https://auth.example.com; base-uri 'none'; form-action 'none'; frame-ancestors 'self'" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
