# Base URL of the Auth API the SPA talks to (no trailing slash).
# Injected at build time by Vite.
VITE_API_BASE_URL=https://localhost:5101
# Google OAuth client id for "Continue with Google" (empty hides the button).
VITE_GOOGLE_CLIENT_ID=
# Apple Services ID for "Continue with Apple" (empty hides the button).
VITE_APPLE_SERVICES_ID=

# Dev TLS. Both SPAs must serve the same scheme as the API or Chrome discards
# the IdP session cookie and OAuth sign-in loops — see Auth_UI/dev-https.ts.
# Export the machine's already-trusted ASP.NET cert once, then set these in
# .env.development.local (gitignored):
#   dotnet dev-certs https --export-path "$env:USERPROFILE\.aspnet\https\localhost.pem" --format PEM --no-password
# DEV_HTTPS_CERT=C:\Users\<you>\.aspnet\https\localhost.pem
# DEV_HTTPS_KEY=C:\Users\<you>\.aspnet\https\localhost.key
