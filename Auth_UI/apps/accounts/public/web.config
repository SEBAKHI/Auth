<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for hosting the Accounts SPA as static files.
  - SPA fallback: any non-file route is served index.html so client-side
    routing (React Router) works on refresh / deep links.
  - Security headers, including a CSP whose connect-src MUST include the
    deployed Auth API origin (keep in sync with VITE_API_BASE_URL).
  - The API origin below is a PLACEHOLDER (RFC 2606, resolves nowhere) and is NOT
    edited by hand. scripts/seal-web-config.mjs rewrites it in dist/web.config
    after every build from VITE_API_BASE_URL, so the policy cannot drift from the
    origin baked into the bundle. Put your own origin in
    apps/accounts/.env.production.local, which git does not track; a build still
    carrying the placeholder is refused instead of shipped.
  - Google Identity Services requires accounts.google.com in script-src,
    connect-src, and frame-src; these stay OUT of the console's CSP.
  - Sign in with Apple requires appleid.cdn-apple.com in script-src and
    appleid.apple.com in connect-src (its sign-in UI opens as a popup
    window, which CSP does not restrict).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- /privacy is a Plesk/IIS virtual directory mapped to persistent
             storage outside this SPA's deployment root. Publishing writes
             extension-bearing .html files there; these local rewrites keep the
             public URLs clean without ARR, a gateway hop, or JavaScript. -->
        <rule name="Privacy Root Canonical Slash" stopProcessing="true">
          <match url="^privacy$" />
          <action type="Redirect" url="/privacy/" redirectType="Permanent" />
        </rule>
        <rule name="Privacy Root Document" stopProcessing="true">
          <match url="^privacy/$" />
          <action type="Rewrite" url="/privacy/index.html" />
        </rule>
        <rule name="Privacy Archive Root Canonical Slash" stopProcessing="true">
          <match url="^privacy/v(\d{4}\.\d{2})$" />
          <action type="Redirect" url="/privacy/v{R:1}/" redirectType="Permanent" />
        </rule>
        <rule name="Privacy Archive Root Document" stopProcessing="true">
          <match url="^privacy/v(\d{4}\.\d{2})/$" />
          <action type="Rewrite" url="/privacy/v{R:1}/index.html" />
        </rule>
        <rule name="Privacy Archive Language Canonical URL" stopProcessing="true">
          <match url="^privacy/v(\d{4}\.\d{2})/((en|ar|tr|fr|zh|ur|fa)(-[A-Za-z0-9]+)?)/$" />
          <action type="Redirect" url="/privacy/v{R:1}/{R:2}" redirectType="Permanent" />
        </rule>
        <rule name="Privacy Archive Language Document" stopProcessing="true">
          <match url="^privacy/v(\d{4}\.\d{2})/(en|ar|tr|fr|zh|ur|fa)(-[A-Za-z0-9]+)?$" />
          <action type="Rewrite" url="/privacy/v{R:1}/{R:2}.html" />
        </rule>
        <rule name="Privacy Language Canonical URL" stopProcessing="true">
          <match url="^privacy/((en|ar|tr|fr|zh|ur|fa)(-[A-Za-z0-9]+)?)/$" />
          <action type="Redirect" url="/privacy/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="Privacy Language Document" stopProcessing="true">
          <match url="^privacy/(en|ar|tr|fr|zh|ur|fa)(-[A-Za-z0-9]+)?$" />
          <action type="Rewrite" url="/privacy/{R:1}.html" />
        </rule>
        <rule name="Privacy Static File" stopProcessing="true">
          <match url="^privacy/(v\d{4}\.\d{2}/)?(index|en|ar|tr|fr|zh|ur|fa)\.html$" />
          <action type="None" />
        </rule>
        <rule name="Privacy Unknown Document" stopProcessing="true">
          <match url="^privacy/.+" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found"
                  statusDescription="The requested privacy-policy document was not found." />
        </rule>
        <rule name="SPA Fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/api/" negate="true" />
            <!-- A deploy removes the previous build's hashed chunks. Without this
                 exclusion a tab still running the old index.html requests a deleted
                 /assets/*.js and gets 200 text/html back, which the module loader
                 rejects with a blank screen — and the 365-day rule below then caches
                 that broken response under a .js URL. Let it 404 honestly instead;
                 RouteErrorBoundary turns the honest failure into one reload. -->
            <add input="{REQUEST_URI}" pattern="^/assets/" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
        <!-- img-src includes the Auth API origin: uploaded images (avatars, logos) are served
             from its /uploads/images path (ImageStorage:PublicBaseUrl). font-src names it too:
             the platform's own fonts (Platform settings > Fonts) are WOFF2 files under
             /uploads/images/fonts/, sent with Access-Control-Allow-Origin: *.

             style-src includes accounts.google.com, and that is not symmetry for its
             own sake. Google's sign-in script fetches its own stylesheet from
             https://accounts.google.com/gsi/style, so a policy that admits the
             script and its button iframe but refuses the stylesheet renders the
             button unstyled and logs a violation on every page that offers it -
             observed twice per page load in a browser before this line.
             Apple's script may want the same for appleid.cdn-apple.com; that is
             unverified, and an origin is not added to a policy on a guess.

             Inline styles (card S02). 'unsafe-inline' in style-src lets anyone who can inject
             markup - not even a script - restyle any page: hide a warning, cover a button.
             It goes in two stages. Stage A (now): the policy below still carries it, and the
             Report-Only header after it carries the target: style-src with no
             'unsafe-inline', only hashes. A browser reports every inline style that target
             would refuse, and blocks nothing. Stage B, once a deployment has shown zero such
             reports in Chrome and Firefox (Google and Apple sign-in included): the enforced
             style-src becomes the Report-Only one, and the Report-Only header goes.
             The hashes are copied from two lists; never compute or edit one here by hand:
               - csp/inline-styles.json: the constant <style> texts the libraries inject,
                 computed by `pnpm csp:collect` from the installed libraries;
               - csp/privacy-style-hashes.json: every stylesheet hash the privacy-policy
                 renderer has ever emitted. /privacy is served from this site, under this
                 policy, and published documents are never rewritten, so the list only grows.
             src/csp-style-policy.test.ts refuses any difference from the two lists,
             and scripts/seal-web-config.mjs refuses a build whose bundle lacks one of the
             library texts or holds a style site csp/bundle-style-sites.json does not count.
             The Report-Only header is this policy with that style-src and without
             frame-ancestors, which the policy above already enforces.

             frame-src 'self': the panel of the sign-in pages frames /login-design-frame.html,
             a document on this origin with a policy of its own (the <location> at the end of
             this file). A page of this origin refuses to be framed itself (X-Frame-Options
             DENY and frame-ancestors 'none' above), so only that page can load in the frame;
             'self' also bounds where a design could send its frame. -->
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' https://accounts.google.com https://appleid.cdn-apple.com; style-src 'self' 'unsafe-inline' https://accounts.google.com; img-src 'self' data: https://auth.example.com; font-src 'self' data: https://auth.example.com; connect-src 'self' https://auth.example.com https://accounts.google.com https://appleid.apple.com; frame-src 'self' https://accounts.google.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" />
        <add name="Content-Security-Policy-Report-Only" value="default-src 'self'; script-src 'self' https://accounts.google.com https://appleid.cdn-apple.com; style-src 'self' 'sha256-47DEQpj8HBSa+/TImW+5JCeuQeRkm5NMpJWZG3hSuFU=' 'sha256-vGQdhYJbTuF+M8iCn1IZCHpdkiICocWHDq4qnQF4Rjw=' 'sha256-441zG27rExd4/il+NvIqyL8zFx5XmyNQtE381kSkUJk=' 'sha256-StEaX+se6YS7pqjzrzMIA0KaX9zF/8zAhvQXZAe5epY=' 'sha256-jyFjan3DmNLOsOOdObNkDhcKV659a083KutwQXvBubY=' https://accounts.google.com; img-src 'self' data: https://auth.example.com; font-src 'self' data: https://auth.example.com; connect-src 'self' https://auth.example.com https://accounts.google.com https://appleid.apple.com; frame-src 'self' https://accounts.google.com; object-src 'none'; base-uri 'self'" />
      </customHeaders>
    </httpProtocol>

    <staticContent>
      <!-- The SPA shell must always be revalidated. A stale index.html can point
           at a removed hashed bundle and leave the application completely blank. -->
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
  </system.webServer>

  <!-- Vite fingerprints everything under assets, so those immutable files can
       keep the long cache without pinning index.html to an old deployment. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
      <!-- The sign-in page design frame (login-design-frame.html) is sandboxed without
           allow-same-origin, so its origin is opaque and its stylesheet and the platform's
           fonts it loads from here are cross-origin requests: without this header the
           browser refuses them. Every file here is public and fingerprinted, and the header
           allows no credentials. -->
      <httpProtocol>
        <customHeaders>
          <add name="Access-Control-Allow-Origin" value="*" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

  <!-- The frame of a sign-in page design (DesignFrame, packages/ui; the panel of the sign-in pages). The page frames it
       with sandbox="allow-scripts allow-popups allow-popups-to-escape-sandbox" (an opaque
       origin: no storage, token or cookie of this app) and posts it the design's HTML, the
       appearance's values and the mode once it says "ready". A design is free HTML and CSS
       an administrator wrote, so this one file gets a policy of its own:
         - script-src: the hash of the receiver script in login-design-frame.html and nothing
           else, so a design's scripts and on* handlers do not run.
           scripts/seal-web-config.mjs recomputes it from the built page and refuses a build
           where they differ (.gitattributes keeps the file LF);
         - style-src 'self' 'unsafe-inline': the design's own styles, and the page's
           stylesheet with the shipped fonts (font-src 'self' data: - the build inlines
           the smallest font subsets as data: URIs, as the site policy allows);
         - font-src also names the Auth API origin: the platform's own fonts (Platform
           settings > Fonts), which the receiver registers from the addresses the page sends;
         - img-src https: data:: images by address from any site, besides uploads (owner
           decision Q9);
         - no network otherwise (default-src 'none'), base-uri and form-action 'none'.
       Links open a new tab (the receiver sets target="_blank" rel="noopener"); the sandbox
       has no allow-top-navigation, so a design cannot take the page away. X-Frame-Options is
       SAMEORIGIN instead of DENY so the page can frame it, and frame-ancestors 'self' keeps
       every other origin out. Fail-closed: if IIS ignored this element, the site policy
       would refuse the receiver, the frame never says "ready", and the panel stays plain. -->
  <location path="login-design-frame.html">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <remove name="Content-Security-Policy" />
          <remove name="Content-Security-Policy-Report-Only" />
          <remove name="X-Frame-Options" />
          <add name="X-Frame-Options" value="SAMEORIGIN" />
          <add name="Content-Security-Policy" value="default-src 'none'; script-src 'sha256-IOQTEb9h+UPDdFdkLHtYao8jfrJ8nNLOpz8NjnaInyo='; style-src 'self' 'unsafe-inline'; font-src 'self' data: https://auth.example.com; img-src https: data:; base-uri 'none'; form-action 'none'; frame-ancestors 'self'" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
