<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for hosting the Accounts SPA as static files.
  - SPA fallback: any non-file route is served index.html so client-side
    routing (React Router) works on refresh / deep links.
  - Security headers, including a CSP whose connect-src MUST include the
    deployed Auth API origin (keep in sync with VITE_API_BASE_URL).
  - Google Identity Services requires accounts.google.com in script-src,
    connect-src, and frame-src; these stay OUT of the console's CSP.
  - Sign in with Apple requires appleid.cdn-apple.com in script-src and
    appleid.apple.com in connect-src (its sign-in UI opens as a popup
    window, which CSP does not restrict).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- /privacy is a Plesk/IIS virtual directory mapped to persistent
             storage outside this SPA's deployment root. Publishing writes
             extension-bearing .html files there; these local rewrites keep the
             public URLs clean without ARR, a gateway hop, or JavaScript. -->
        <rule name="Privacy Root Canonical Slash" stopProcessing="true">
          <match url="^privacy$" />
          <action type="Redirect" url="/privacy/" redirectType="Permanent" />
        </rule>
        <rule name="Privacy Root Document" stopProcessing="true">
          <match url="^privacy/$" />
          <action type="Rewrite" url="/privacy/index.html" />
        </rule>
        <rule name="Privacy Archive Root Canonical Slash" stopProcessing="true">
          <match url="^privacy/v(\d{4}\.\d{2})$" />
          <action type="Redirect" url="/privacy/v{R:1}/" redirectType="Permanent" />
        </rule>
        <rule name="Privacy Archive Root Document" stopProcessing="true">
          <match url="^privacy/v(\d{4}\.\d{2})/$" />
          <action type="Rewrite" url="/privacy/v{R:1}/index.html" />
        </rule>
        <rule name="Privacy Archive Language Canonical URL" stopProcessing="true">
          <match url="^privacy/v(\d{4}\.\d{2})/((en|ar|tr|fr|zh|ur|fa)(-[A-Za-z0-9]+)?)/$" />
          <action type="Redirect" url="/privacy/v{R:1}/{R:2}" redirectType="Permanent" />
        </rule>
        <rule name="Privacy Archive Language Document" stopProcessing="true">
          <match url="^privacy/v(\d{4}\.\d{2})/(en|ar|tr|fr|zh|ur|fa)(-[A-Za-z0-9]+)?$" />
          <action type="Rewrite" url="/privacy/v{R:1}/{R:2}.html" />
        </rule>
        <rule name="Privacy Language Canonical URL" stopProcessing="true">
          <match url="^privacy/((en|ar|tr|fr|zh|ur|fa)(-[A-Za-z0-9]+)?)/$" />
          <action type="Redirect" url="/privacy/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="Privacy Language Document" stopProcessing="true">
          <match url="^privacy/(en|ar|tr|fr|zh|ur|fa)(-[A-Za-z0-9]+)?$" />
          <action type="Rewrite" url="/privacy/{R:1}.html" />
        </rule>
        <rule name="Privacy Static File" stopProcessing="true">
          <match url="^privacy/(v\d{4}\.\d{2}/)?(index|en|ar|tr|fr|zh|ur|fa)\.html$" />
          <action type="None" />
        </rule>
        <rule name="Privacy Unknown Document" stopProcessing="true">
          <match url="^privacy/.+" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found"
                  statusDescription="The requested privacy-policy document was not found." />
        </rule>
        <rule name="SPA Fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/api/" negate="true" />
            <!-- A deploy removes the previous build's hashed chunks. Without this
                 exclusion a tab still running the old index.html requests a deleted
                 /assets/*.js and gets 200 text/html back, which the module loader
                 rejects with a blank screen — and the 365-day rule below then caches
                 that broken response under a .js URL. Let it 404 honestly instead;
                 RouteErrorBoundary turns the honest failure into one reload. -->
            <add input="{REQUEST_URI}" pattern="^/assets/" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
        <!-- img-src includes the Auth API origin: uploaded images (avatars, logos) are served
             from its /uploads/images path (ImageStorage:PublicBaseUrl). -->
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' https://accounts.google.com https://appleid.cdn-apple.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://auth-sandbox.sebakhi.com; font-src 'self' data:; connect-src 'self' https://auth-sandbox.sebakhi.com https://accounts.google.com https://appleid.apple.com; frame-src https://accounts.google.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" />
      </customHeaders>
    </httpProtocol>

    <staticContent>
      <!-- The SPA shell must always be revalidated. A stale index.html can point
           at a removed hashed bundle and leave the application completely blank. -->
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
  </system.webServer>

  <!-- Vite fingerprints everything under assets, so those immutable files can
       keep the long cache without pinning index.html to an old deployment. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
