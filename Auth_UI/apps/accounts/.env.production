# PLACEHOLDERS. example.com is reserved for documentation (RFC 2606) and resolves
# nowhere, so an unedited build fails on its first request instead of quietly
# sending sign-in credentials somewhere else. Vite bakes these in at build time -
# they cannot be corrected on the server - and nothing validates them:
# packages/api/src/env.ts falls back only when a key is ABSENT, never when it is
# wrong. Must match the connect-src and img-src origin in public/web.config.
VITE_API_BASE_URL=https://auth.example.com
# Public origin of this accounts app. Privacy links stay on this origin.
VITE_ACCOUNTS_URL=https://accounts.example.com
# Google OAuth client id (must match the API's Google audience).
VITE_GOOGLE_CLIENT_ID=
# Apple Services ID (must match the API's Apple audience).
VITE_APPLE_SERVICES_ID=
