# Set this to the deployed Auth API origin at build time.
# Must match the CSP connect-src in public/web.config.
VITE_API_BASE_URL=https://auth.astoom.com
# Google OAuth client id (must match the API's Google audience).
VITE_GOOGLE_CLIENT_ID=
# Apple Services ID (must match the API's Apple audience).
VITE_APPLE_SERVICES_ID=
